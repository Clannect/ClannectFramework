{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (contract checks + bounds checks)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ubsan-trap",
      "inherits": "base",
      "displayName": "Debug + UBSan (trap mode, works on MinGW)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CFW_SANITIZE": "ubsan-trap" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug + ASan/UBSan (Clang or GCC on Linux/macOS; MSVC)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CFW_SANITIZE": "address;undefined" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "ubsan-trap", "configurePreset": "ubsan-trap" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "ubsan-trap", "configurePreset": "ubsan-trap", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
