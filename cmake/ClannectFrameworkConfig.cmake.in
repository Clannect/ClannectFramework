# find_package(ClannectFramework) for an installed Clannect Framework.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if("@CFW_PLATFORM_BACKEND@" STREQUAL "X11")
    find_dependency(X11)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ClannectFrameworkTargets.cmake")
check_required_components(ClannectFramework)
