// The installer's manifest (asInvoker) and version information.
#include <winver.h>

1 24 "installer.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 0, 0, 0
PRODUCTVERSION 0, 0, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Clannect"
            VALUE "FileDescription", "Clannect Framework Setup"
            VALUE "ProductName", "Clannect Framework"
            VALUE "LegalCopyright", "Open Use License (OUL) v1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
